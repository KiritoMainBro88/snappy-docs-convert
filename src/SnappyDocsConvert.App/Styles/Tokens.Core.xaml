<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Non-color design tokens (theme-independent). Colors live in Theme.Light/Theme.Dark. -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999,999,999,999</CornerRadius>

    <Thickness x:Key="InputBorderThickness">1</Thickness>
    <Thickness x:Key="BorderThickness">1</Thickness>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Small">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">19</sys:Double>
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Display">30</sys:Double>

    <sys:Double x:Key="Control.MinHeight">34</sys:Double>
    <sys:Double x:Key="Control.SmallMinHeight">28</sys:Double>
    <sys:Double x:Key="Row.MinHeight">38</sys:Double>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SymbolFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="LogFontFamily">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
