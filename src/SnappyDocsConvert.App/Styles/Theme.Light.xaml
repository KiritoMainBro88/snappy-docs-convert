    <SolidColorBrush x:Key="WarningStrokeBrush" Color="#FEDF89" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEF3F2" />
    <SolidColorBrush x:Key="ErrorStrokeBrush" Color="#F4B7B2" />

    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="#E5E7EB" />
</ResourceDictionary>
