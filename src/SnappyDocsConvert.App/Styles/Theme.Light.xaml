<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- LIGHT THEME. The complete semantic color token set. No literal hex outside theme files. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#101828" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#354052" />

    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SoftPanelBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="PillIdleBrush" Color="#F2F4F7" />

    <SolidColorBrush x:Key="BorderBrushSoft" Color="#D0D5DD" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#98A2B3" />
    <SolidColorBrush x:Key="SoftAccentStrokeBrush" Color="#BFDBFE" />

    <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8" />
