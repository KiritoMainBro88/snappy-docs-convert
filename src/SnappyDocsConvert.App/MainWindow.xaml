<Window x:Class="SnappyDocsConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SnappyDocsConvert.App.Converters"
        xmlns:v="clr-namespace:SnappyDocsConvert.App.Validation"
        Title="kmb file tools"
        MinHeight="720"
        MinWidth="1180"
        Height="820"
        Width="1360"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">
    <Window.Resources>
        <conv:PageToBoolConverter x:Key="PageToBool" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Panel}" Margin="0,0,0,14" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="52"
                        Height="52"
                        CornerRadius="{StaticResource Radius.Large}"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource SoftAccentStrokeBrush}"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock Text="KMB" Style="{StaticResource LogoInitials}" />
                        <Image Source="{Binding LogoPath}" Stretch="UniformToFill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogoPath}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Loc[AppName]}" Style="{StaticResource TitleText}" FontSize="24" />
                        <Border Style="{StaticResource PrivacyBadge}" Margin="14,2,0,0">
                            <TextBlock Text="{Binding Loc[PrivacyBadge]}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentModeTitle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentModeDescription}" Style="{StaticResource TinyMutedText}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="EN" Command="{Binding UseEnglishCommand}" Style="{StaticResource SmallButton}" />
                    <Button Content="VI" Command="{Binding UseVietnameseCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SidebarPanel}" Margin="0,0,14,0">
            <StackPanel>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavConvert"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=Convert}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavConvert]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavPdfTools"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=PdfTools}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavPdfTools]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavEngines"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=Engines}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavEngines]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavLogs"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=Logs}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavLogs]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavSettings"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=Settings}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavSettings]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             AutomationProperties.AutomationId="NavHelp"
                             IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource PageToBool}, ConverterParameter=Help}"
                             Style="{StaticResource NavItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;"
                                   FontFamily="{StaticResource SymbolFontFamily}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[NavHelp]}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="Convert">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource AlertPanel}">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[Alert]}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{Binding AlertText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding RejectedPaths}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="DropZoneBorder"
                        Style="{StaticResource DropZone}"
                        Cursor="Hand"
                        PreviewMouseLeftButtonDown="DropZone_MouseLeftButtonDown"
                        MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                        AutomationProperties.Name="Ngăn kéo thả tệp — click để chọn tệp (file drop zone, click to add files)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource SoftAccentStrokeBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="{StaticResource SymbolFontFamily}"
                                       FontSize="18"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc[DropTitle]}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Loc[SupportedFormats]}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Loc[EmptyQueue]}" Style="{StaticResource TinyMutedText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="{Binding Loc[AddFiles]}" Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{Binding Loc[AddFolder]}" Command="{Binding AddFolderCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,12,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Loc[Output]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Loc[OutputFolder]}" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="{Binding Loc[Choose]}"
                                        Command="{Binding ChooseOutputFolderCommand}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Loc[Conversion]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Loc[Target]}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TargetChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTarget}" />
                            <TextBlock Text="{Binding Loc[Engine]}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding EngineChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedEngine}" />
                            <TextBlock Text="{Binding SelectedEngineGuidance}"
                                       Style="{StaticResource TinyMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ToggleButton Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding EnableEngineFallback}"
                                              AutomationProperties.Name="{Binding Loc[EnableEngineFallback]}" />
                                <TextBlock Text="{Binding Loc[EnableEngineFallback]}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSize.Small}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Loc[Images]}" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Loc[ImageFormat]}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ImageFormatChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedImageFormat}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Loc[Dpi]}" Style="{StaticResource FieldLabel}" />
                                    <TextBox ToolTip="{Binding Loc[DpiHelp]}">
                                        <TextBox.Text>
                                            <Binding Path="Dpi" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <v:DpiRangeValidationRule />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="{Binding Loc[KeepIntermediate]}" IsChecked="{Binding KeepIntermediatePdf}" />
                            <TextBlock Text="{Binding Loc[DpiHelp]}" Style="{StaticResource TinyMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Queue}"
                          SelectedItem="{Binding SelectedQueueItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternationCount="2"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2.1*" MinWidth="190">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[File], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" />
                                        <TextBlock Text="{Binding InputPath}" Style="{StaticResource TinyMutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Type}" Width="70">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[Type], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Target}" Width="110">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[QueueTarget], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Engine}" Width="120">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[Engine], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="112">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[Status], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPillBorder}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.7*" MinWidth="160">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[Message], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.6*" MinWidth="160">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.Loc[Output], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Output}" Style="{StaticResource TinyMutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Output}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DataContext.Loc[Open], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.OpenItemOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Loc[RemoveSelected]}" Command="{Binding RemoveSelectedCommand}" />
                        <Button Content="{Binding Loc[ClearQueue]}" Command="{Binding ClearCommand}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="{Binding Loc[StartQueue]}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" />
                        <Button Content="{Binding Loc[OpenOutput]}" Command="{Binding OpenOutputFolderCommand}" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="Settings">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsAppearance]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Loc[Theme]}" Style="{StaticResource FieldLabel}" />
                            <WrapPanel>
                                <Button Content="{Binding Loc[ThemeSystem]}" Command="{Binding UseSystemThemeCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="{Binding Loc[ThemeLight]}" Command="{Binding UseLightThemeCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="{Binding Loc[ThemeDark]}" Command="{Binding UseDarkThemeCommand}" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TinyMutedText}">
                                <Run Text="{Binding Loc[EffectiveTheme], Mode=OneWay}" />
                                <Run Text=": " />
                                <Run Text="{Binding EffectiveThemeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsLanguage]}" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Button Content="{Binding Loc[LanguageAuto]}" Command="{Binding UseSystemLanguageCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="{Binding Loc[LanguageEnglish]}" Command="{Binding UseEnglishCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="{Binding Loc[LanguageVietnamese]}" Command="{Binding UseVietnameseCommand}" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsUpdates]}" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CurrentVersion]}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CurrentVersion}" />
                                    <TextBlock Text="{Binding Loc[CurrentCommit]}" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding CurrentCommit}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Loc[UpdateChannel]}" Style="{StaticResource FieldLabel}" />
                                    <WrapPanel>
                                        <Button Content="{Binding Loc[UpdateChannelStable]}" Command="{Binding UseStableUpdatesCommand}" Style="{StaticResource SmallButton}" />
                                        <Button Content="{Binding Loc[UpdateChannelPrerelease]}" Command="{Binding UsePrereleaseUpdatesCommand}" Style="{StaticResource SmallButton}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SelectedUpdateChannel}" Style="{StaticResource TinyMutedText}" Margin="6,8,0,0" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{Binding Loc[CheckForUpdates]}" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="{Binding Loc[DownloadUpdate]}" Command="{Binding DownloadUpdateCommand}" />
                                <Button Content="{Binding Loc[InstallRestart]}" Command="{Binding InstallUpdateCommand}" />
                                <Button Content="{Binding Loc[OpenReleasePage]}" Command="{Binding OpenReleasePageCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Height="12" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding LatestVersion}" Style="{StaticResource TinyMutedText}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Loc[ReleaseNotes]}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReleaseNotesPreview, Mode=OneWay}" MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsAbout]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Loc[AboutLocal]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Loc[AboutLicense]}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{Binding Loc[OpenSource]}" Command="{Binding OpenSourceCommand}" />
                                <Button Content="{Binding Loc[OpenDiscord]}" Command="{Binding OpenDiscordCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="PdfTools">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AlertPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Alert]}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding AlertText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding RejectedPaths}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource ToolCard}">
                            <TextBlock Text="{Binding Loc[ToolMerge]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource ToolCard}">
                            <TextBlock Text="{Binding Loc[ToolSplit]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource ToolCard}">
                            <TextBlock Text="{Binding Loc[ToolExtract]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource ToolCard}">
                            <TextBlock Text="{Binding Loc[ToolRotate]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border Style="{StaticResource ToolCard}">
                            <TextBlock Text="{Binding Loc[ToolImagesToPdf]}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="{Binding Loc[PdfToolsIntro]}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Loc[Operation]}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PdfToolOperationChoices}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedPdfToolOperation}" />

                                <TextBlock Text="{Binding Loc[Inputs]}" Style="{StaticResource FieldLabel}" />
                                <ListBox ItemsSource="{Binding PdfToolInputs}"
                                         MinHeight="138"
                                         BorderBrush="{DynamicResource BorderBrushSoft}"
                                         Background="{DynamicResource PanelBrush}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{Binding Loc[AddPdfToolInputs]}" Command="{Binding AddPdfToolFilesCommand}" Style="{StaticResource PrimaryButton}" />
                                    <Button Content="{Binding Loc[ClearInputs]}" Command="{Binding ClearPdfToolInputsCommand}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Loc[OutputFileName]}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding PdfToolOutputFileName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Loc[MainOutputFolderHint]}" Style="{StaticResource TinyMutedText}" Margin="0,6,0,0" />

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPdfToolPageRangeVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Loc[PageRange]}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PdfToolPageRanges, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Loc[PageRangeHint]}" />
                                    <TextBlock Text="{Binding Loc[PageRangeHint]}" Style="{StaticResource TinyMutedText}" Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPdfToolRotationVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Loc[Rotation]}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding PdfRotationChoices}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPdfRotationAngle}" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPdfToolWatermarkVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Loc[PdfToolWatermarkText]}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PdfToolWatermarkText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPdfToolPasswordVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Loc[PdfToolPassword]}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PdfToolPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Content="{Binding Loc[StartTool]}" Command="{Binding RunPdfToolCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" />
                                <Border Style="{StaticResource SettingsGroup}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[Result]}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding PdfToolStatus}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroup}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[RejectedFiles]}" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding RejectedPaths}" MinHeight="80" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="Engines">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="4" DataContext="{Binding EngineStatus}" Margin="0,0,0,12">
                        <Border Style="{StaticResource EngineCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.Loc[MicrosoftWord], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WordStatus}" Style="{StaticResource StatusValueText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EngineCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.Loc[PowerPoint], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PowerPointStatus}" Style="{StaticResource StatusValueText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EngineCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.Loc[LibreOffice], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LibreOfficeStatus}" Style="{StaticResource StatusValueText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EngineCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.Loc[PdfRenderer], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PdfRendererStatus}" Style="{StaticResource StatusValueText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SetupGuidance]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding EngineStatus.Guidance}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EngineStatus.LibreOfficePath}" Style="{StaticResource TinyMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Loc[HaveOffice]}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding Loc[NoOffice]}" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="{Binding Loc[Recheck]}" Command="{Binding RecheckEnginesCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="{Binding Loc[ChooseSoffice]}" Command="{Binding ChooseLibreOfficeCommand}" />
                                <Button Content="{Binding Loc[OpenLibreOfficeDownload]}" Command="{Binding OpenLibreOfficeDownloadCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="Logs">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Loc[Log]}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Grid.Column="1">
                            <Button Content="{Binding Loc[CopyLogs]}" Style="{StaticResource SmallButton}" Command="{Binding CopyLogsCommand}" />
                            <Button Content="{Binding Loc[ClearLog]}" Style="{StaticResource SmallButton}" Command="{Binding ClearLogCommand}" />
                        </WrapPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Style="{StaticResource LogListBox}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource PageHost}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage}" Value="Help">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[HelpLocal]}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[HelpConvert]}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[HelpTools]}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[HelpLibreOffice]}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Loc[HelpLimitations]}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                <!-- File-granularity progress: advances only when a file completes, never
                     mid-file, matching what the pipeline actually reports. -->
                <ProgressBar
                    Grid.Column="1"
                    Width="140"
                    Height="6"
                    Margin="0,0,14,0"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding OverallPercent, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="2" Text="{Binding Loc[PrivacyBadge]}" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
